if RM57_DCAN

config RM57_DCAN_TXFIFO_DEPTH
	int "DCAN TX FIFO depth (mailboxes per instance)"
	default 8
	range 1 32
	---help---
		Number of message objects reserved for transmission, taken
		from the top of the 64-mailbox range so that RX filters keep
		the (higher priority) low mailbox numbers.

config RM57_DCAN_RXFIFO_DEPTH
	int "DCAN RX FIFO depth (mailboxes per filter)"
	default 8
	range 1 32
	---help---
		Number of message objects chained (EoB) into the receive FIFO
		of each acceptance filter, including the default catch-all
		filter installed when no user filter is active.

config RM57_DCAN_NFILTERS_MAX
	int "DCAN maximum concurrent acceptance filters"
	default 4
	range 1 8

config RM57_DCAN_IF3_NFRAMES
	int "DCAN IF3 DMA ring size (frames)"
	default 16
	range 2 64
	depends on RM57_DCAN1_RX_IF3DMA || RM57_DCAN2_RX_IF3DMA || \
		RM57_DCAN3_RX_IF3DMA || RM57_DCAN4_RX_IF3DMA

config RM57_DCAN_SECDED
	bool "DCAN message RAM SECDED (ECC)"
	default y
	---help---
		Keep the message RAM single-error-correction/double-error-
		detection logic enabled (CTL.PMD).  Disable only for
		bring-up debugging; parity events are reported through the
		CAN error reporting path when enabled.

config RM57_DCAN_LOOPBACK
	bool "DCAN internal loopback at setup (self-test)"
	default n
	---help---
		Enter internal loopback test mode (TEST.LBack) as part of
		controller setup so the driver can be exercised without a
		transceiver or bus.  Frames are looped back internally; the
		CAN_TX pin stays recessive.  Can also be controlled at
		runtime via CANIOC_SET_CONNMODES.

endif # RM57_DCAN

endmenu # RM57 Peripheral Support

endif # ARCH_CHIP_RM57
