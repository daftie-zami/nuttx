if ARCH_CHIP_RM57

comment "RM57 Configuration Options"

# Chip Selection

choice
	prompt "TI Hercules RM57 Chip Selection"
	default ARCH_CHIP_RM57L843

config ARCH_CHIP_RM57L843
	bool "TI RM57L843"
	select ARCH_CORTEXR5
	select ARCH_HAVE_FPU

endchoice # TI Hercules RM57 Chip Selection

menu "RM57 Peripheral Support"

config RM57_SCI1
	bool "Serial Communication Interface 1 (SCI1/LIN1, SCI-compatibility mode)"
	default n
	select SCI1_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config RM57_SCI2
	bool "Serial Communication Interface 2 (SCI2/LIN2, SCI-compatibility mode)"
	default n
	select SCI2_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config RM57_SCI3
	bool "Serial Communication Interface 3 (SCI3)"
	default n
	select SCI3_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config RM57_SCI4
	bool "Serial Communication Interface 4 (SCI4)"
	default n
	select SCI4_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config RM57_DMA
	bool "DMA controller (32-channel, 48 request lines)"
	default n
	---help---
		Enable the general-purpose DMA controller driver. Required by the
		RM57_SCIn_RXDMA/TXDMA serial DMA options.

config RM57_SCI1_RXDMA
	bool "SCI1/LIN1 receive DMA"
	default n
	depends on RM57_SCI1 && RM57_DMA
	select SERIAL_RXDMA

config RM57_SCI1_TXDMA
	bool "SCI1/LIN1 transmit DMA"
	default n
	depends on RM57_SCI1 && RM57_DMA
	select SERIAL_TXDMA

config RM57_SCI2_RXDMA
	bool "SCI2/LIN2 receive DMA"
	default n
	depends on RM57_SCI2 && RM57_DMA
	select SERIAL_RXDMA

config RM57_SCI2_TXDMA
	bool "SCI2/LIN2 transmit DMA"
	default n
	depends on RM57_SCI2 && RM57_DMA
	select SERIAL_TXDMA

config RM57_SCI3_RXDMA
	bool "SCI3 receive DMA"
	default n
	depends on RM57_SCI3 && RM57_DMA
	select SERIAL_RXDMA

config RM57_SCI3_TXDMA
	bool "SCI3 transmit DMA"
	default n
	depends on RM57_SCI3 && RM57_DMA
	select SERIAL_TXDMA

config RM57_SCI4_RXDMA
	bool "SCI4 receive DMA"
	default n
	depends on RM57_SCI4 && RM57_DMA
	select SERIAL_RXDMA

config RM57_SCI4_TXDMA
	bool "SCI4 transmit DMA"
	default n
	depends on RM57_SCI4 && RM57_DMA
	select SERIAL_TXDMA

config RM57_LIN
	bool "LIN 2.x driver scaffold (LIN1/LIN2 modules)"
	default n
	depends on EXPERIMENTAL
	---help---
		Configuration and polled transfer foundation for LIN-mode
		operation of the SCI1/LIN1 and SCI2/LIN2 dual-role modules (see
		rm57_lin.h). Not integrated with the serial upper half, and not
		a complete LIN protocol stack - see rm57_lin.h for what is and
		is not implemented.

		A LIN module cannot be used simultaneously in SCI mode
		(RM57_SCI1/RM57_SCI2) and LIN mode; this is a runtime choice,
		not enforced here, since e.g. SCI1 could run in SCI mode while
		SCI2/LIN2 runs in LIN mode.

config RM57_SERIAL_RXDMA_BUFFER_SIZE
	int "RX DMA buffer size"
	default 64
	depends on RM57_SCI1_RXDMA || RM57_SCI2_RXDMA || RM57_SCI3_RXDMA || \
		RM57_SCI4_RXDMA
	---help---
		The DMA buffer size when using RX DMA. This buffer is used to
		receive data on the SCI while waiting for the application to
		claim it. Rounded up to a multiple of the 32-byte Cortex-R5
		D-cache line size.

config RM57_SERIAL_RXDMA_POLL
	bool "Periodic RX DMA flush"
	default y
	depends on RM57_SCI1_RXDMA || RM57_SCI2_RXDMA || RM57_SCI3_RXDMA || \
		RM57_SCI4_RXDMA
	---help---
		RX DMA hands received bytes to the upper half only when the
		DMA half/full interrupt fires, that is, after half of
		RM57_SERIAL_RXDMA_BUFFER_SIZE bytes. The SCI has no idle-line
		interrupt to signal the end of a shorter burst, so this option
		dedicates RTI compare 1 to calling rm57_serial_dma_poll()
		periodically, which bounds the added receive latency by the
		poll period.

		Leave this enabled unless every RX DMA port is used purely for
		bulk transfers; without it, a short message sits in the ring
		buffer until enough further bytes arrive, and an RX DMA console
		is unusable interactively.

config RM57_SERIAL_RXDMA_POLL_HZ
	int "RX DMA flush frequency (Hz)"
	default 1000
	range 1 100000
	depends on RM57_SERIAL_RXDMA_POLL
	---help---
		How often the RX DMA rings are flushed, in Hz. The worst-case
		added receive latency is one poll period; the cost is one short
		interrupt at this rate, which checks one pointer per enabled
		port and returns when nothing was received.

config RM57_DCAN
	bool
	default n
	---help---
		Hidden umbrella symbol selected by any RM57_DCANn instance;
		pulls the shared DCAN core driver into the build.

menuconfig RM57_DCAN1
	bool "DCAN1 CAN controller"
	default n
	select RM57_DCAN

if RM57_DCAN1

choice
	prompt "DCAN1 driver framework"
	default RM57_DCAN1_CHARDRIVER

config RM57_DCAN1_CHARDRIVER
	bool "Character device driver (/dev/canN)"
	select CAN
	select CAN_TXREADY
	select CAN_USE_RTR
	select ARCH_HAVE_CAN_ERRORS

config RM57_DCAN1_SOCKET
	bool "SocketCAN network driver"
	depends on NET_CAN
	select NET_CAN_HAVE_ERRORS

endchoice # DCAN1 driver framework

config RM57_DCAN1_BAUD
	int "DCAN1 initial bit rate"
	default 500000
	range 1000 1000000

choice
	prompt "DCAN1 RX path"
	default RM57_DCAN1_RX_PIO

config RM57_DCAN1_RX_PIO
	bool "IF2 programmed I/O (interrupt per message)"

config RM57_DCAN1_RX_IF3IRQ
	bool "IF3 auto-update with IF3 interrupt"

config RM57_DCAN1_RX_IF3DMA
	bool "IF3 auto-update with DMA (EXPERIMENTAL)"
	depends on RM57_DMA && EXPERIMENTAL

endchoice # DCAN1 RX path

endif # RM57_DCAN1

menuconfig RM57_DCAN2
	bool "DCAN2 CAN controller"
	default n
	select RM57_DCAN

