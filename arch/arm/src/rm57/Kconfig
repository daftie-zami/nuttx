menuconfig RM57_DCAN4
	bool "DCAN4 CAN controller"
	default n
	select RM57_DCAN
	---help---
		DCAN4 pins are shared with GIOB[2] (ball F2, CAN4 TX) and
		GIOB[3] (ball W10, CAN4 RX).  The board pinmux claims them for
		CAN when this option is enabled.

if RM57_DCAN4

choice
	prompt "DCAN4 driver framework"
	default RM57_DCAN4_CHARDRIVER

config RM57_DCAN4_CHARDRIVER
	bool "Character device driver (/dev/canN)"
	select CAN
	select CAN_TXREADY
	select CAN_USE_RTR
	select ARCH_HAVE_CAN_ERRORS

config RM57_DCAN4_SOCKET
	bool "SocketCAN network driver"
	depends on NET_CAN
	select NET_CAN_HAVE_ERRORS

endchoice # DCAN4 driver framework

config RM57_DCAN4_BAUD
	int "DCAN4 initial bit rate"
	default 500000
	range 1000 1000000

choice
	prompt "DCAN4 RX path"
	default RM57_DCAN4_RX_PIO

config RM57_DCAN4_RX_PIO
	bool "IF2 programmed I/O (interrupt per message)"

config RM57_DCAN4_RX_IF3IRQ
	bool "IF3 auto-update with IF3 interrupt"

